# SimulaPro — regras para a hospedagem Apache/LiteSpeed (Hostinger), pasta public_html/SimulaPro
# O GitHub Pages ignora este arquivo.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # A câmera do celular só funciona com HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Pastas de teste e de desenvolvimento não abrem no site
  RewriteRule ^(testes|gerador)(/|$) - [F,L]
  RewriteRule ^(CONTEXTO|README)\.md$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Libera a câmera nesta pasta (caso o site principal a bloqueie)
  Header always set Permissions-Policy "camera=(self)"
  # Sempre buscar a versão nova da página e do service worker
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
