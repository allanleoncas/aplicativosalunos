# SimulaPro — regras para a hospedagem Apache/LiteSpeed (Hostinger), pasta public_html/SimulaPro
# O GitHub Pages ignora este arquivo.

# allanleon.com.br/SimulaPro/ abre a página de apresentação; o app fica em index.html
DirectoryIndex apresentacao.html index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # A câmera do celular só funciona com HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # O login manda a sessão no cabeçalho Authorization: repassa para o PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Pastas de teste, de desenvolvimento e de dados não abrem no site
  RewriteRule ^(testes|gerador|_dados)(/|$) - [F,L]
  RewriteRule ^(CONTEXTO|README)\.md$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Libera a câmera nesta pasta (caso o site principal a bloqueie)
  Header always set Permissions-Policy "camera=(self)"
  # Sempre buscar a versão nova da página e do service worker
  <FilesMatch "^(index\.html|apresentacao\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
